---
const plans = [
  {
    color: "c1",
    tier: "Emprendedor",
    badge: true,
    featured: true,
    price: "$250.000",
    description: "Página web estática, ideal para emprendedores que quieren tener presencia en internet de forma rápida y profesional.",
    cta: "Empezar",
    infoLabel: "Antes de empezar",
    infoHref: "/antes-de-empezar",
    ctaHref: "https://wa.me/573005720253",
    features: [
      "Página estática (1 a 3 páginas)",
      "Diseño moderno, limpio y responsive",
      "Botón directo a WhatsApp",
      "Estructura clara e intuitiva",
      "SEO optimizado para Google",
      "Formulario de contacto",
      "Hosting incluido 1 año",
      "Dominio no incluido",
      "2 revisiones incluidas",
      "Entrega en 5 días",
    ],
    renewalNote: "*El primer año de hosting está incluido en este precio, después el hosting se renueva en 99.000+IVA por año.",
  },
  {
    color: "c2",
    tier: "Profesional",
    price: "$390.000",
    description: "Sitio web dinámico con animaciones y transiciones, pensado para negocios que buscan impactar y diferenciarse.",
    cta: "Empezar",
    infoLabel: "Antes de empezar",
    infoHref: "/antes-de-empezar",
    ctaHref: "https://wa.me/573005720253",
    features: [
      "Página dinámica con animaciones (hasta 5 páginas)",
      "Transiciones y efectos de scroll",
      "Diseño moderno, limpio y responsive",
      "Botón directo a WhatsApp",
      "Estructura clara e intuitiva",
      "SEO avanzado para Google",
      "Formularios de contacto",
      "Hosting incluido 1 año",
      "Dominio incluido 1 año",
      "4 revisiones incluidas",
      "Entrega en 8–10 días",
    ],
    renewalNote: "*El primer año de hosting y dominio está incluido en este precio, después se renueva en 149.000+IVA por año.",
  },
  {
    color: "c3",
    tier: "Rediseño",
    pricePrefix: "Desde",
    price: "$390.000",
    description: "Optimización y rediseño de tu sitio web actual para mejorar su imagen, estructura y resultados.",
    cta: "Evaluar mi página",
    infoLabel: "Antes de rediseñar",
    infoHref: "/antes-de-redisenar",
    ctaHref: "https://wa.me/573005720253",
    features: [
      "Rediseño visual moderno y profesional",
      "Mejora de estructura y contenido",
      "Optimización UX/UI",
      "Diseño responsive",
      "SEO avanzado",
      "Botón de contacto (WhatsApp, etc.)",
      "3 revisiones incluidas",
      "Entrega según evaluación",
    ],
    renewalNote: "*Hosting y dominio según plan. Se brinda asesoría para su adquisición.",
  },
];

const checkSvg = `<svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const starSvg = `<svg viewBox="0 0 24 24" fill="none" width="12" height="12"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/></svg>`;
---

<header class="svc-header">
  <p class="svc-label">Servicios</p>
  <h1 class="svc-title">
    Planes pensados para llevar tu<br />
    <span class="hl">presencia digital</span> al siguiente nivel
  </h1>
</header>

<div class="svc-tags">
  <span class="svc-tag">Diseño web</span>
  <span class="svc-tag">Desarrollo web</span>
  <span class="svc-tag">UI/UX</span>
  <span class="svc-tag">Acompañamiento</span>
</div>

<section class="svc-pricing">
  <div class="svc-grid stg">
    {plans.map((plan) => (
      <div class:list={["svc-card", plan.color, "reveal", plan.featured && "featured"]}>
        <div class="svc-accent"></div>
        <div class="svc-body">
          {plan.badge && (
            <div class="svc-badge">
              <Fragment set:html={starSvg} />
              Más elegido
            </div>
          )}
          <p class="svc-plan">{plan.tier}</p>
          <div class="svc-price">
            {plan.pricePrefix && <span class="svc-prefix">{plan.pricePrefix}</span>}
            {plan.price}
          </div>
          <p class="svc-desc">{plan.description}</p>
          <div class="svc-divider"></div>
          <ul class="svc-features">
            {plan.features.map((f) => (
              <li>
                <span class="svc-check"><Fragment set:html={checkSvg} /></span>
                {f}
              </li>
            ))}
          </ul>
          <div class="svc-buttons">
            <a href={plan.infoHref} class="svc-btn-outline">{plan.infoLabel}</a>
            <a href={plan.ctaHref} target="_blank" rel="noreferrer" class="svc-btn-solid">{plan.cta}</a>
          </div>
          {plan.renewalNote && <p class="svc-note">{plan.renewalNote}</p>}
        </div>
      </div>
    ))}
  </div>
</section>
