---
const serviceLabels = ["Diseño web", "Desarrollo web", "UI/UX", "Acompañamiento"];

const plans = [
  {
    tier: "Emprendedor",
    badge: "Más elegido",
    price: "$250.000",
    description: "Página web estática, ideal para emprendedores que quieren tener presencia en internet de forma rápida y profesional.",
    cta: "Empezar",
    infoLabel: "Antes de empezar",
    infoHref: "/antes-de-empezar",
    ctaHref: "https://wa.me/573005720253",
    recommended: true,
    features: [
      "Página estática (1 a 3 páginas)",
      "Diseño moderno, limpio y responsive",
      "Botón directo a WhatsApp",
      "Estructura clara e intuitiva",
      "SEO optimizado para Google",
      "Formulario de contacto",
      "Hosting incluido 1 año",
      "Dominio no incluido",
      "2 revisiones incluidas",
      "Entrega en 5 días",
    ],
    renewalNote: "*El primer año de hosting está incluido en este precio, después el hosting se renueva en 99.000+IVA por año.",
  },
  {
    tier: "Profesional",
    price: "$400.000",
    description: "Sitio web dinámico con animaciones y transiciones, pensado para negocios que buscan impactar y diferenciarse.",
    cta: "Empezar",
    infoLabel: "Antes de empezar",
    infoHref: "/antes-de-empezar",
    ctaHref: "https://wa.me/573005720253",
    features: [
      "Página dinámica con animaciones (hasta 5 páginas)",
      "Transiciones y efectos de scroll",
      "Diseño moderno, limpio y responsive",
      "Botón directo a WhatsApp",
      "Estructura clara e intuitiva",
      "SEO avanzado para Google",
      "Formularios de contacto",
      "Hosting incluido 1 año",
      "Dominio incluido 1 año",
      "4 revisiones incluidas",
      "Entrega en 8–10 días",
    ],
    renewalNote: "*El primer año de hosting y dominio está incluido en este precio, después el hosting y dominio se renueva en 149.000+IVA por año.",
  },
  {
    tier: "Rediseño",
    variant: "redesign",
    price: "Desde $390.000",
    description: "Optimización y rediseño de tu sitio web actual para mejorar su imagen, estructura y resultados.",
    cta: "Evaluar mi página",
    infoLabel: "Antes de rediseñar",
    infoHref: "/antes-de-redisenar",
    ctaHref: "https://wa.me/573005720253",
    features: [
      "Rediseño visual moderno y profesional",
      "Mejora de estructura y contenido",
      "Optimización UX/UI",
      "Diseño responsive",
      "SEO avanzado",
      "Botón de contacto (WhatsApp, etc.)",
      "3 revisiones incluidas",
      "Entrega según evaluación",
    ],
  },
];
---

<section class="page-section page-section-tight px-4 pb-8 pt-0 sm:px-6 sm:pb-10">
  <div class="site-container">
    <div class="service-pill-grid mb-5 mt-1.5 sm:mb-6 sm:mt-2 sm:gap-4 reveal">
      {serviceLabels.map((label) => (
        <span class="inline-flex items-center justify-center rounded-full border border-sky-200/80 bg-white/70 px-4 py-2 text-sm font-medium text-slate-700 shadow-[0_8px_20px_rgba(148,163,184,0.08)] transition duration-200 hover:border-sky-300 hover:bg-sky-50/80 hover:text-sky-700">
          {label}
        </span>
      ))}
    </div>

    <div class="pricing-grid">
      {plans.map((plan, i) => (
        <article class:list={["pricing-card", "reveal", `reveal-d${i + 1}`, plan.recommended && "is-featured is-recommended", plan.variant === "redesign" && "is-redesign"]}>
          {plan.badge && <span class="pricing-recommended-badge">{plan.badge}</span>}

          <div class="pricing-card-top">
            <p class="pricing-tier">{plan.tier}</p>
            <div class="mt-3 flex items-baseline gap-1.5">
              <h2 class="font-display text-[1.5rem] font-semibold tracking-[-0.04em] text-slate-950 sm:text-[1.7rem]">
                {plan.price}
              </h2>
              {plan.priceNote && (
                <span class="text-sm font-medium text-slate-400">{plan.priceNote}</span>
              )}
            </div>

            <p class="pricing-copy mt-4">{plan.description}</p>
          </div>

          <ul class="pricing-features mt-5">
            {plan.features.map((feature) => (
              <li>
                <span class="pricing-check" aria-hidden="true">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="pricing-actions mt-7">
            <a href={plan.infoHref} class:list={["pricing-cta", "is-info"]}>
              {plan.infoLabel}
            </a>
            <a href={plan.ctaHref} target="_blank" rel="noreferrer" class:list={["pricing-cta", "is-primary"]}>
              {plan.cta}
            </a>
          </div>

          {plan.renewalNote && (
            <p class="mt-4 text-[0.72rem] leading-5 text-slate-400 italic">
              {plan.renewalNote}
            </p>
          )}
        </article>
      ))}
    </div>

    <p class="pricing-note mx-auto mt-5 max-w-3xl text-center text-sm text-slate-500">
      *Hosting y dominio según plan. Se brinda asesoría para su adquisición.
    </p>
  </div>
</section>
