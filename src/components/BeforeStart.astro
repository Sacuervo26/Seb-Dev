---
const sections = [
  {
    icon: "📋",
    iconClass: "abs-icon-blue",
    title: "Lo esencial",
    subtitle: "Sin esto no podemos arrancar",
    items: [
      { title: "Nombre de tu negocio o marca", desc: "El nombre con el que quieres aparecer en tu página web." },
      { title: "Qué hace tu negocio", desc: "Describe en 2-3 líneas qué ofreces, a quién le vendes y qué te hace diferente." },
      { title: "Servicios o productos con precios", desc: "Lista lo que ofreces con precios (si aplica). Esto va directo a tu página." },
      { title: "Datos de contacto", desc: "WhatsApp, teléfono, correo electrónico, dirección (si tienes local físico), redes sociales." },
    ],
  },
  {
    icon: "🎨",
    iconClass: "abs-icon-green",
    title: "Tu imagen",
    subtitle: "Lo visual que representa tu marca",
    items: [
      { title: "Logo en buena calidad", desc: "En formato PNG con fondo transparente es ideal. Si no tienes logo, no te preocupes — te puedo asesorar." },
      { title: "Colores de tu marca", desc: "Si ya tienes colores definidos, compártelos. Si no, los definimos juntos durante el proceso." },
      { title: "Fotos de tu negocio o productos", desc: "Fotos reales de tus productos, local, equipo de trabajo o de ti mismo. La calidad importa — buena luz y buena resolución." },
    ],
  },
  {
    icon: "✍️",
    iconClass: "abs-icon-orange",
    title: "Contenido",
    subtitle: "Los textos e información de tu página",
    items: [
      { title: "Secciones que quieres en tu web", desc: "Ej: Inicio, Servicios, Nosotros, Contacto, Portafolio, Precios. Dime cuáles necesitas." },
      { title: "Textos para cada sección", desc: "No tienen que ser perfectos. Escribe las ideas principales y yo me encargo de darles forma profesional." },
      { title: "Referencias visuales", desc: "¿Hay alguna página web que te guste? Compárteme el link. Esto me ayuda a entender tu estilo." },
    ],
  },
];

const totalItems = sections.reduce((acc, s) => acc + s.items.length, 0);
---

<section class="ph" style="padding-bottom:24px;">
  <div class="ph-bl"></div>
  <p class="sl">Guía para clientes</p>
  <h1>Antes de empezar tu <span class="hl">página web</span></h1>
  <p class="abs-intro ao">
    Marca los elementos que ya tienes listos. Esto nos ayuda a avanzar más rápido y a que tu página quede exactamente como la necesitas.
  </p>
</section>

<div class="abs-confetti" id="absConfetti"></div>

<div class="abs-container">
  <!-- Progress -->
  <div class="abs-progress ao">
    <div class="abs-progress-header">
      <span class="abs-progress-label">Tu progreso</span>
      <span class="abs-progress-count" id="absProgressCount">0 de {totalItems} listos</span>
    </div>
    <div class="abs-progress-bar">
      <div class="abs-progress-fill" id="absProgressFill"></div>
    </div>
    <p class="abs-progress-message" id="absProgressMessage">Marca los elementos que ya tienes listos</p>
  </div>

  <!-- Sections -->
  {sections.map((sec) => (
    <div class="abs-section ao">
      <div class="abs-section-header">
        <div class:list={["abs-section-icon", sec.iconClass]}>{sec.icon}</div>
        <div>
          <div class="abs-section-title">{sec.title}</div>
          <div class="abs-section-subtitle">{sec.subtitle}</div>
        </div>
      </div>
      <div class="abs-checklist">
        {sec.items.map((it) => (
          <div class="abs-check-item">
            <div class="abs-checkbox">
              <svg viewBox="0 0 14 14"><path d="M2 7L5.5 10.5L12 3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <div class="abs-check-content">
              <div class="abs-check-title">{it.title}</div>
              <div class="abs-check-desc">{it.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- Tip -->
  <div class="abs-tip ao">
    <span class="abs-tip-icon">💡</span>
    <div class="abs-tip-text">
      <strong>No necesitas tener todo perfecto.</strong> Lo importante es tener la información organizada. Si te falta algo, lo trabajamos juntos durante el proceso. Lo que sí te pido es enviar toda la información en un solo documento de Word o PDF para no perder nada.
    </div>
  </div>

  <!-- Info card: Hosting y dominio -->
  <div class="abs-info-card ao">
    <h3>Sobre el hosting y dominio</h3>
    <p>El primer año está incluido en tu plan. A partir del segundo año, tú asumes la renovación para mantener tu sitio activo. Te aviso antes del vencimiento.</p>
    <div class="abs-info-grid">
      <div class="abs-info-box abs-info-blue">
        <div class="abs-info-label">Plan Emprendedor</div>
        <div class="abs-info-value">$99.000+IVA/año</div>
      </div>
      <div class="abs-info-box abs-info-green">
        <div class="abs-info-label">Plan Profesional</div>
        <div class="abs-info-value">$149.000+IVA/año</div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="abs-cta ao">
    <h2>¿Ya tienes todo listo?</h2>
    <p>Escríbeme por WhatsApp y arrancamos con tu página web esta semana.</p>
    <a href="https://wa.me/573013455585" target="_blank" rel="noreferrer" class="abs-cta-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
      Escribir por WhatsApp
    </a>
    <br />
    <a href="/servicios" class="abs-cta-link">Ver planes y precios →</a>
  </div>
</div>

<script is:inline define:vars={{ totalItems }}>
  function initBeforeStart() {
    var items = document.querySelectorAll(".abs-check-item");
    if (!items.length) return;

    var fill = document.getElementById("absProgressFill");
    var count = document.getElementById("absProgressCount");
    var msg = document.getElementById("absProgressMessage");
    var confettiContainer = document.getElementById("absConfetti");

    items.forEach(function(item) {
      var newItem = item.cloneNode(true);
      item.parentNode.replaceChild(newItem, item);
      newItem.addEventListener("click", function() {
        newItem.classList.toggle("checked");
        updateProgress();
      });
    });

    function updateProgress() {
      var checked = document.querySelectorAll(".abs-check-item.checked").length;
      var pct = Math.round((checked / totalItems) * 100);

      if (fill) fill.style.width = pct + "%";
      if (count) count.textContent = checked + " de " + totalItems + " listos";

      if (msg) {
        if (checked === 0) msg.textContent = "Marca los elementos que ya tienes listos";
        else if (checked < 4) msg.textContent = "Buen inicio, sigue marcando lo que tengas";
        else if (checked < 7) msg.textContent = "Vas muy bien, ya casi tienes todo";
        else if (checked < totalItems) msg.textContent = "Casi listo, solo te faltan unos pocos";
        else {
          msg.textContent = "Tienes todo listo, escríbeme y arrancamos";
          launchConfetti();
        }
      }
    }

    function launchConfetti() {
      if (!confettiContainer) return;
      confettiContainer.style.display = "block";
      confettiContainer.innerHTML = "";
      var colors = ["#2563eb", "#7c3aed", "#059669", "#ea580c", "#eab308", "#ec4899"];
      for (var i = 0; i < 60; i++) {
        var c = document.createElement("div");
        c.className = "abs-confetti-piece";
        c.style.left = Math.random() * 100 + "%";
        c.style.background = colors[Math.floor(Math.random() * colors.length)];
        c.style.animationDelay = Math.random() * 1.5 + "s";
        c.style.width = (Math.random() * 8 + 6) + "px";
        c.style.height = (Math.random() * 8 + 6) + "px";
        confettiContainer.appendChild(c);
      }
      setTimeout(function() { confettiContainer.style.display = "none"; }, 3000);
    }
  }

  initBeforeStart();
  document.addEventListener("astro:after-swap", initBeforeStart);
</script>
