---
const heroTags = ["Diseño web", "Desarrollo web", "UI/UX", "Acompañamiento"];
---

<section class="hr">
  <div class="hr-sh a"></div>
  <div class="hr-sh b"></div>
  <div class="hr-dt"></div>

  <div class="hr-in">
    <div class="hrc">
      <div class="hr-tg">
        {heroTags.map((tag) => <span class="tg">{tag}</span>)}
      </div>

      <p class="hr-lb">Arquitecto y desarrollador web</p>

      <h1 class="hr-tt">
        Diseño experiencias digitales <span class="hl">claras, modernas y profesionales</span> para marcas y negocios.
      </h1>

      <p class="hr-ds">
        Combino estructura, criterio visual y desarrollo web para crear sitios limpios, bien pensados y fáciles de recorrer.
      </p>

      <div class="hr-bt">
        <a href="/servicios" class="bp">
          Servicios
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://wa.me/573013455585" target="_blank" rel="noreferrer" class="bs">
          Hablemos
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13.5 2.5L7 9M13.5 2.5L9.5 13.5L7 9M13.5 2.5L2.5 6.5L7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="hr-v">
      <div class="hr-iw">
        <div class="hr-rg"></div>
        <div class="hr-gl"></div>
        <img class="hr-im" src="/perfil.png" alt="Sebastián Cuervo" loading="eager" />
        <div class="hr-bd hr-bd-top">
          <div class="bi bi-b">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#2563eb"/></svg>
          </div>
          UI/UX Design
        </div>
        <div class="hr-bd hr-bd-bottom">
          <div class="bi bi-g">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M16 18l2-2-4-4 4-4-2-2-6 6 6 6z" fill="#16a34a"/><path d="M8 6l-2 2 4 4-4 4 2 2 6-6-6-6z" fill="#16a34a"/></svg>
          </div>
          Dev Web
        </div>
      </div>
    </div>
  </div>
</section>
