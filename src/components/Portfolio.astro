---
const projects = [
  {
    title: "Almamakeup",
    category: "Website de servicios",
    description: "Empresa dedicada al maquillaje para quinceañeras y novias, además de cursos y servicios pensados para proyectar una imagen más profesional y cercana.",
    image: "/alma-studio.jpg",
    href: "https://almamakeup.com.co/",
  },
  {
    title: "Envueltos El Mana",
    category: "Landing page",
    description: "Landing page para una empresa que vende productos derivados de la mazorca, con un diseño limpio y directo para mostrar mejor su marca y facilitar el contacto.",
    image: "/envueltos-el-mana.jpg",
    href: "https://envueltos-el-mana.vercel.app",
  },
  {
    title: "Clínica Veterinaria Latidos",
    category: "Sitio web profesional",
    description: "Clínica veterinaria especializada con quirófano equipado, ecografía diagnóstica y atención exclusiva para perros y gatos.",
    image: "/clinica-latidos.webp",
    href: "https://clinica-veterinaria-latidos-ld.vercel.app/",
  },
];

const arrowSvg = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="ph">
  <div class="ph-bl"></div>
  <p class="sl">Proyectos</p>
  <h1>Trabajos que reflejan <span class="hl">criterio visual y desarrollo sólido</span></h1>
</section>

<section style="padding:48px 40px 100px; max-width:1200px; margin:0 auto;">
  <div class="pjg stg">
    {projects.map((project) => (
      <a href={project.href} class="pjc ao" target="_blank" rel="noopener noreferrer">
        <div class="pji">
          <img src={project.image} alt={project.title} loading="lazy" />
          <span class="pjb">{project.category}</span>
        </div>
        <div class="pjct">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="pjl">
            Visitar proyecto
            <Fragment set:html={arrowSvg} />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
