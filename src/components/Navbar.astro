---
const { currentPath = "/" } = Astro.props;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/antes-de-empezar", label: "Antes de empezar", highlight: true },
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/contacto", label: "Contacto" },
];
---

<nav class="nv" id="nv">
  <a href="/" class="nv-logo">
    <img src="/Logo.png" alt="sebweb.co" />
  </a>

  <ul class="nl">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            currentPath === link.href && "on",
            link.highlight && "nl-highlight",
          ]}
          aria-current={currentPath === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <a href="https://wa.me/573013455585" target="_blank" rel="noreferrer" class="nv-cta nv-cta-desktop">Hablemos</a>

  <button class="hm" id="hm" aria-label="Menú">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- Floating card menu -->
  <div class="fm" id="fm">
    <div class="fm-header">
      <span class="fm-label">Navegación</span>
      <button class="fm-close" id="fmClose" aria-label="Cerrar menú">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="fm-links">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "fm-link",
            currentPath === link.href && "active",
            link.highlight && "fm-link-highlight",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="fm-bottom">
      <a href="https://wa.me/573013455585" target="_blank" rel="noreferrer" class="fm-cta">Hablemos</a>
    </div>
  </div>
</nav>

<div class="fm-backdrop" id="fmBackdrop"></div>

<script is:inline>
  function initFm() {
    var hm = document.getElementById("hm");
    var fm = document.getElementById("fm");
    var bd = document.getElementById("fmBackdrop");
    var fmClose = document.getElementById("fmClose");
    if (!hm || !fm) return;

    var newHm = hm.cloneNode(true);
    hm.parentNode.replaceChild(newHm, hm);

    var newBd = bd ? bd.cloneNode(true) : null;
    if (bd && newBd) bd.parentNode.replaceChild(newBd, bd);

    var newClose = fmClose ? fmClose.cloneNode(true) : null;
    if (fmClose && newClose) fmClose.parentNode.replaceChild(newClose, fmClose);

    function close() {
      newHm.classList.remove("open");
      fm.classList.remove("open");
      if (newBd) newBd.classList.remove("open");
      document.body.classList.remove("menu-open");
      document.body.style.overflow = "";
    }

    newHm.addEventListener("click", function() {
      var isOpen = fm.classList.contains("open");
      if (isOpen) { close(); }
      else {
        newHm.classList.add("open");
        fm.classList.add("open");
        if (newBd) newBd.classList.add("open");
        document.body.classList.add("menu-open");
      }
    });

    if (newBd) newBd.addEventListener("click", close);
    if (newClose) newClose.addEventListener("click", close);
    fm.querySelectorAll("a").forEach(function(a) { a.addEventListener("click", close); });
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && fm.classList.contains("open")) close();
    });
  }

  initFm();
  document.addEventListener("astro:after-swap", initFm);
</script>
