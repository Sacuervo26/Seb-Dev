---
const { currentPath = "/" } = Astro.props;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/contacto", label: "Contacto" },
];
---

<nav class="nv" id="nv">
  <a href="/" class="nv-logo">
    <img src="/Logo.png" alt="sebweb.co" />
  </a>

  <ul class="nl">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[currentPath === link.href && "on"]}
          aria-current={currentPath === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <a href="https://wa.me/573005720253" target="_blank" rel="noreferrer" class="nv-cta nv-cta-desktop">Hablemos</a>

  <button class="hm" id="hm" aria-label="Menú">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<!-- Backdrop -->
<div class="mo-backdrop" id="moBackdrop"></div>

<!-- Side panel menu -->
<div class="mo" id="mo">
  <div class="mo-header">
    <a href="/" class="nv-logo">
      <img src="/Logo.png" alt="sebweb.co" />
    </a>
    <button class="mo-close" id="moClose" aria-label="Cerrar menú">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="mo-links">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={["mo-link", currentPath === link.href && "active"]}
      >
        {link.label}
      </a>
    ))}
  </div>

  <div class="mo-bottom">
    <a href="https://wa.me/573005720253" target="_blank" rel="noreferrer" class="mo-cta-btn">Hablemos</a>
  </div>
</div>

<script is:inline>
  (() => {
    const hm = document.getElementById("hm");
    const mo = document.getElementById("mo");
    const moClose = document.getElementById("moClose");
    const backdrop = document.getElementById("moBackdrop");
    if (!hm || !mo) return;

    function openMenu() {
      hm.classList.add("open");
      mo.classList.add("open");
      if (backdrop) backdrop.classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      hm.classList.remove("open");
      mo.classList.remove("open");
      if (backdrop) backdrop.classList.remove("open");
      document.body.style.overflow = "";
    }

    hm.addEventListener("click", () => {
      mo.classList.contains("open") ? closeMenu() : openMenu();
    });

    if (moClose) moClose.addEventListener("click", closeMenu);
    if (backdrop) backdrop.addEventListener("click", closeMenu);

    mo.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mo.classList.contains("open")) closeMenu();
    });
  })();
</script>
