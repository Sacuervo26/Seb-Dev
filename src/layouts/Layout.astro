---
import { ViewTransitions } from "astro:transitions";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

const siteUrl = "https://sebweeb.com";

const {
  title = "SebWeeb | Diseño y desarrollo web en Colombia",
  description = "Diseño y desarrollo de páginas web profesionales en Colombia. Sitios modernos, rápidos y optimizados para tu negocio desde $250.000 COP.",
  ogImage = "/perfil.png",
  keywords = "diseño web Colombia, desarrollador web, páginas web profesionales, diseño de sitios web, desarrollo web Astro, diseñador web Bogotá, páginas web para negocios, rediseño web, UI UX Colombia, Sebastián Cuervo",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Sebastián Cuervo" />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Colombia" />
    <meta name="language" content="Spanish" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SebWeeb - Diseño y desarrollo web en Colombia" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="SebWeeb" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "SebWeeb",
      "alternateName": "SebWeeb - Sebastián Cuervo",
      "url": siteUrl,
      "inLanguage": "es-CO",
      "publisher": {
        "@type": "Person",
        "name": "Sebastián Cuervo"
      }
    })} />

    <!-- JSON-LD: ProfessionalService (local business) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#business`,
      "name": "SebWeeb - Sebastián Cuervo",
      "alternateName": "SebWeeb",
      "description": "Diseño y desarrollo de sitios web modernos, claros y profesionales para marcas y negocios en Colombia.",
      "url": siteUrl,
      "logo": `${siteUrl}/Logo.png`,
      "image": `${siteUrl}/perfil.png`,
      "telephone": "+573013455585",
      "email": "sacuervo.dev@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO",
        "addressRegion": "Colombia"
      },
      "areaServed": [
        { "@type": "Country", "name": "Colombia" },
        { "@type": "Place", "name": "Latinoamérica" }
      ],
      "serviceType": [
        "Diseño web",
        "Desarrollo web",
        "Rediseño de sitios web",
        "UI/UX",
        "Acompañamiento técnico"
      ],
      "priceRange": "$250.000 - $390.000 COP",
      "currenciesAccepted": "COP",
      "paymentAccepted": "Transferencia bancaria, PSE, Nequi",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+573013455585",
        "contactType": "customer service",
        "email": "sacuervo.dev@gmail.com",
        "areaServed": "CO",
        "availableLanguage": ["Spanish", "es"]
      },
      "sameAs": [],
      "founder": {
        "@type": "Person",
        "name": "Sebastián Cuervo",
        "jobTitle": "Arquitecto y Desarrollador Web",
        "image": `${siteUrl}/perfil.png`,
        "nationality": "CO"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de diseño y desarrollo web",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plan Emprendedor",
              "description": "Página web estática de 1 a 3 páginas, diseño moderno y responsive."
            },
            "price": "250000",
            "priceCurrency": "COP",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plan Profesional",
              "description": "Sitio web dinámico con animaciones, hasta 5 páginas y optimización completa."
            },
            "price": "390000",
            "priceCurrency": "COP",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plan Rediseño",
              "description": "Rediseño completo de sitios web existentes con enfoque en conversión y experiencia de usuario."
            },
            "priceCurrency": "COP",
            "availability": "https://schema.org/InStock"
          }
        ]
      }
    })} />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Sebastián Cuervo",
      "alternateName": "Seb",
      "jobTitle": "Arquitecto y Desarrollador Web",
      "url": siteUrl,
      "image": `${siteUrl}/perfil.png`,
      "email": "sacuervo.dev@gmail.com",
      "telephone": "+573013455585",
      "nationality": { "@type": "Country", "name": "Colombia" },
      "worksFor": { "@type": "Organization", "name": "SebWeeb" }
    })} />
  </head>
  <body>
    <slot />
    <FloatingWhatsApp />

    <script>
      function initReveal() {
        const els = document.querySelectorAll(".ao:not(.v), .reveal:not(.visible)");
        if (!els.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add(
                  entry.target.classList.contains("ao") ? "v" : "visible"
                );
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );

        els.forEach((el) => observer.observe(el));
      }

      function initCounters() {
        const counters = document.querySelectorAll("[data-target]");
        if (!counters.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const target = parseInt(el.dataset.target, 10);
              const suffix = el.dataset.suffix || "";
              const duration = 2000;
              const start = performance.now();

              function tick(now) {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.floor(eased * target) + suffix;
                if (progress < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
              observer.unobserve(el);
            });
          },
          { threshold: 0.3 }
        );

        counters.forEach((el) => observer.observe(el));
      }

      function initNavScroll() {
        const nav = document.getElementById("nv");
        if (!nav) return;
        function check() {
          nav.classList.toggle("scrolled", window.scrollY > 50);
        }
        window.addEventListener("scroll", check, { passive: true });
        check();
      }

      function initAll() {
        initReveal();
        initCounters();
        initNavScroll();
      }

      document.addEventListener("DOMContentLoaded", initAll);
      document.addEventListener("astro:after-swap", () => {
        initAll();
        const hm = document.getElementById("hm");
        const fm = document.getElementById("fm");
        const fmBackdrop = document.getElementById("fmBackdrop");
        if (hm) hm.classList.remove("open");
        if (fm) fm.classList.remove("open");
        if (fmBackdrop) fmBackdrop.classList.remove("open");
        document.body.style.overflow = "";
      });
      if (document.readyState !== "loading") initAll();
    </script>
  </body>
</html>
